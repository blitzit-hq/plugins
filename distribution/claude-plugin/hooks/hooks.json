{
  "description": "Blitzit creates a task on the first prompt and records coding-session time. Background hooks stay silent; the prompt hook returns the current checklist.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/blitzit-hook",
            "args": [
              "agent",
              "session-start",
              "--provider",
              "claude-code"
            ],
            "timeout": 15
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/blitzit-hook",
            "args": [
              "agent",
              "prompt",
              "--provider",
              "claude-code"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/blitzit-hook",
            "args": [
              "agent",
              "activity",
              "--provider",
              "claude-code"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/blitzit-hook",
            "args": [
              "agent",
              "session-end",
              "--provider",
              "claude-code"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
